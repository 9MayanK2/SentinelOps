##############################################################
# DevSecOps Enterprise Framework Environment Configuration
##############################################################

# Database Configuration (AWS RDS MySQL / PostgreSQL / SQLite)
# Supported values for DB_TYPE: mysql | postgres | sqlite
DB_TYPE=mysql
DB_HOST=sentinelops-dev-mysql.ccxs8u0gof49.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=sentinelops
DB_USER=admin
DB_PASSWORD=your_rds_database_password_here

# Local SQLite Fallback Path (Used when DB_TYPE=sqlite)
DB_PATH=compliance/db/security_framework.db

# NVD API 2.0 Authentication Key (Increases rate limit from 5 req/30s to 50 req/30s)
NVD_API_KEY=your_nvd_api_key_here

# Image Signing & Verification Password (Cosign / Sigstore)
COSIGN_PASSWORD=your_cosign_private_key_password_here

# DAST & Target Network Configuration
ZAP_TARGET_URL=http://sentinelops-frontend:8080

# Security Gate Enforcement Policy
# SOFT_FAIL=true allows pipeline to proceed with exit code 0 even if gate fails (testing/dev mode)
# SOFT_FAIL=false strictly fails the pipeline job with exit code 1
SOFT_FAIL=false
ENFORCE_GATE=true
